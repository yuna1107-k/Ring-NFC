# Ring NFC モード切替 — 環境変数テンプレート
# このファイルを .env にコピーして値を埋めてください。
#   cp .env.example .env
# .env はコミットしないでください（.gitignore 済み）。

# 対象ロケーションID（空なら自動検出。複数拠点がある場合は必須）
RING_LOCATION_ID=

# トークンキャッシュの保存先（authorize 実行で生成される）
RING_TOKEN_CACHE=./ring_token.cache

# Ring API 用 User-Agent 名（任意の文字列でOK）
RING_USER_AGENT=RingNfcSwitch/1.0

# ---- 端末検出による自動切替 ----------------------------------------
# 在宅判定に使う端末（スマホ等）の IP アドレス。カンマ区切りで複数指定可。
# 複数指定時は「全端末が見えない状態が続いたら不在」「どれか1台でも見えたら在宅」。
# ルーターの DHCP 固定割り当てで IP を固定してください。空なら端末検出は無効。
# 192.168.128.182 = Xperia 1 VI（yuna-s-Xperia1VI）
PRESENCE_HOSTS=192.168.128.182

# この秒数以上続けて端末が見えなければ不在にする（スマホのスリープ対策で長めに）
PRESENCE_ABSENT_SECONDS=600

# 端末を確認する間隔（秒）
PRESENCE_CHECK_INTERVAL=30

# 接続時 / 不在時に設定するモード（home / away / disarmed）
PRESENCE_HOME_MODE=home
PRESENCE_AWAY_MODE=away

# ---- NFC カードによるトグル（任意） -----------------------------------
# true で NFC リーダー（PN532）によるトグルも有効にする
NFC_ENABLED=false

# PN532 の CS(SS) を接続した GPIO（例: D25 / D8=CE0）
PN532_CS_PIN=D25

# 同一カードの連続読取を無視する秒数
DEBOUNCE_SECONDS=3

# 反応対象カードのUID（大文字・区切りなし。空なら任意のカードで動作）
CARD_UID=

# トグルする2モード（home / away / disarmed から選択）
TOGGLE_MODE_A=home
TOGGLE_MODE_B=away
